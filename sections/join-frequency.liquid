{%- style -%}
  #JoinFrequency-{{ section.id }} {
    --color-button: var(--mode-accent);
    --color-button-text: var(--mode-bg);
  }
{%- endstyle -%}

<div
  id="JoinFrequency-{{ section.id }}"
  class="join-frequency mode--{{ section.settings.mode }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  {%- if section.settings.show_shapes -%}
    <div class="decorative-shape decorative-shape--top-left" style="color: rgb(var(--mode-accent-2));">
      {%- render 'shape-triangle', width: 50, height: 50 -%}
    </div>
    <div class="decorative-shape decorative-shape--top-right" style="color: rgb(var(--mode-accent));">
      {%- render 'shape-zigzag', width: 80, height: 14 -%}
    </div>
    <div class="decorative-shape decorative-shape--bottom-right" style="color: rgb(var(--mode-accent-2));">
      {%- render 'shape-grid', width: 44, height: 44 -%}
    </div>
  {%- endif -%}

  <div class="join-frequency__inner page-width">
    <div class="join-frequency__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1000
          | image_tag: class: 'join-frequency__image', sizes: '(min-width: 750px) 40vw, 80vw', widths: '375, 550, 750, 1000'
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'join-frequency__image placeholder-svg' }}
      {%- endif -%}
    </div>

    <div class="join-frequency__text">
      {%- if section.settings.heading != blank -%}
        <h2 class="join-frequency__heading font-display">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="join-frequency__body">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- liquid
        assign join_frequency_form_id = 'JoinFrequencyForm-' | append: section.id
      -%}
      {%- form 'customer', id: join_frequency_form_id, class: 'join-frequency__form newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="join-frequency__field-wrapper">
          <div class="field">
            <input
              id="JoinFrequencyEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              class="field__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                autofocus
                aria-invalid="true"
                aria-describedby="JoinFrequencyError-{{ section.id }}"
              {% elsif form.posted_successfully? %}
                aria-describedby="JoinFrequencySuccess-{{ section.id }}"
              {% endif %}
              placeholder="Enter your email address"
              required
            >
            <label class="field__label" for="JoinFrequencyEmail-{{ section.id }}">Enter your email address</label>
            <button type="submit" class="button join-frequency__submit" name="commit">
              {{- section.settings.button_label | escape -}}
            </button>
          </div>
          {%- if form.errors -%}
            <small class="newsletter-form__message form__message" id="JoinFrequencyError-{{ section.id }}">
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </small>
          {%- endif -%}
        </div>
        {%- if form.posted_successfully? -%}
          <p
            class="newsletter-form__message newsletter-form__message--success form__message"
            id="JoinFrequencySuccess-{{ section.id }}"
            tabindex="-1"
          >
            You're on the signal. Thanks for joining the frequency.
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Join the frequency",
  "tag": "section",
  "class": "section section--join-frequency",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "mode",
      "label": "Mode",
      "options": [
        { "value": "heritage", "label": "Heritage" },
        { "value": "broadcast", "label": "Broadcast" }
      ],
      "default": "broadcast"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "A cutout/transparent image works best -- it bleeds off the edge of the panel."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join The Frequency"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Receive upcoming Broadcast schedules, early access, stories, and occasional transmissions.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Tune In"
    },
    {
      "type": "header",
      "content": "Decoration"
    },
    {
      "type": "checkbox",
      "id": "show_shapes",
      "label": "Show decorative shapes",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Join the frequency"
    }
  ]
}
{% endschema %}

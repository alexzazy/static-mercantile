{% comment %}
  Renders the "Transmission Ended" banner for archived Broadcast products,
  or (with force: true) for a collection page showing archived items in
  bulk (the Static Archive collection). This is the visual notice only --
  product templates that render it should also check the same tag to
  disable Add to Cart / variant selection, per the bible's "disable
  purchasing, keep the page visible" rule.

  Accepts:
  - product: {Object} Product Liquid object (optional) -- renders when
    product.tags contains 'transmission-ended'
  - force: {Boolean} render unconditionally, ignoring product/tags
    (optional, for collection-level use)
  - text: {String} override copy (optional)

  Usage:
  {% render 'archive-banner', product: product %}
  {% render 'archive-banner', force: true %}
{% endcomment %}
{%- liquid
  assign show_banner = false
  if force
    assign show_banner = true
  elsif product.tags contains 'transmission-ended'
    assign show_banner = true
  endif
-%}
{%- if show_banner -%}
  <div class="archive-banner">
    <span class="archive-banner__label font-eyebrow">Transmission Ended</span>
    <p class="archive-banner__text">
      {%- if text != blank -%}
        {{ text }}
      {%- elsif product != blank -%}
        This Broadcast has ended and is no longer available for purchase. {{ product.title }} remains here in the Static
        Archive.
      {%- else -%}
        These Broadcasts have ended and are no longer available for purchase. They remain here in the Static Archive.
      {%- endif -%}
    </p>
  </div>
{%- endif -%}
